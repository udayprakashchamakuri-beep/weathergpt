# ---------------------------------------------------------------------------
# WeatherGPT configuration. Copy to backend/.env and fill in what you have.
# Everything here is OPTIONAL -- the service runs with none of it set, using
# open NWP output, bundled language templates and the rule-based router.
# ---------------------------------------------------------------------------

# --- IMD, the authoritative source -----------------------------------------
# Register: https://api.imd.gov.in/public/register.php   (free; IP whitelisting)
# Reference: https://api.imd.gov.in/public/api_reference.html
# With this set, warnings / nowcasts / cyclone / marine answers come from IMD
# and are labelled "authoritative" in the UI.
IMD_API_KEY=

# --- Bhashini (MeitY) language stack ---------------------------------------
# https://bhashini.gitbook.io/bhashini-apis   ASR + NMT + TTS, 22 languages.
# Only needed for languages beyond the six with bundled templates, and for
# server-side speech (the browser Web Speech API covers the demo).
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- LLM router ------------------------------------------------------------
# Used ONLY to turn free text into a typed intent, never to produce a number.
# llm_provider: none | groq | openai | gemini | ollama
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=http://localhost:11434/v1     # e.g. on-prem Ollama inside IMD

# --- runtime ---------------------------------------------------------------
CACHE_TTL_SECONDS=600
HTTP_TIMEOUT=12
DEFAULT_LANG=en

# --- deployment guards -----------------------------------------------------
# All optional; unset = the permissive local-dev behaviour the README promises.

# Browser origins allowed to call the API, comma-separated. Unset defaults to
# "*". Pin this to the deployed origin on anything public, e.g.
# On Render, leave this UNSET: the app then pins CORS to RENDER_EXTERNAL_URL,
# which Render injects as the service's own URL. Example if setting manually:
#   CORS_ALLOW_ORIGINS=https://weathergpt.onrender.com
CORS_ALLOW_ORIGINS=

# Shared secret required by /api/alerts/simulate, /subscribe and /scan.
# Unset = gate open (local dev). NEVER commit a real value: set it in the
# platform's secret store. On Render it is generated for you (render.yaml).
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(24))"
DEMO_TOKEN=

# Per-IP request ceilings; 0 disables a limiter.
# Set RATE_LIMIT_CHAT_PER_MIN=0 when running tests/test_smoke.py.
RATE_LIMIT_CHAT_PER_MIN=60
RATE_LIMIT_SUBSCRIBE_PER_MIN=10

# The demo dissemination endpoints. Kept true so /simulate works on stage.
ENABLE_DEMO_ENDPOINTS=true

# Port the app binds to. Honoured when set; defaults to 8000 locally.
# Render injects this itself (default 10000) -- do not pin it there.
PORT=8000

# --- NWP fallback (MET Norway) ---------------------------------------------
# api.open-meteo.com rate-limits by source IP, and a free managed host shares
# one egress IP across tenants -- on Render it returns 429 to every forecast
# request. MET Norway is the automatic fallback; its Provenance names it, so
# the source chip in the UI changes when it answers.
#
# REQUIRED for the fallback to be reliable. MET Norway's terms require a
# User-Agent naming the app and a contact address they can reach:
#   https://api.met.no/doc/TermsOfService
METNO_CONTACT=you@example.com

# Total seconds one request may spend on upstream NWP calls across ALL
# providers. Prevents a rate-limited upstream from tying up the instance.
UPSTREAM_BUDGET_S=12

# --- OpenWeatherMap (preferred NWP source) ---------------------------------
# Free tier: 60 calls/min, 1M/month, no card. Uses the 2.5 endpoints
# (/data/2.5/weather and /data/2.5/forecast). Do NOT switch these to
# /data/3.0/onecall -- that is a separately-subscribed product and returns 401
# on a free-tier key.
#
# Preferred over the other sources because the quota is KEYED to this
# deployment rather than shared with every tenant on the host's egress IP, and
# because it supplies wind gusts and probability of precipitation, which MET
# Norway does not publish for India.
#
# Leave BLANK here. Set it in the platform environment only; an empty value
# means the provider is skipped, which is the correct safe default.
OPENWEATHER_API_KEY=
